# Copy to .env (local) or set these in your host's dashboard (production).
# Get keys at https://dashboard.paystack.com/#/settings/developers  (use TEST keys first)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Plan codes: Paystack dashboard > Products > Plans. Create 3 monthly plans in NGN:
#   Personal 1000, Family 3000, Family Plus 5000 (amounts must match config.js), then copy each PLN_ code.
PAYSTACK_PLAN_PERSONAL=PLN_xxxxxxxx
PAYSTACK_PLAN_FAMILY=PLN_xxxxxxxx
PAYSTACK_PLAN_FAMILY_PLUS=PLN_xxxxxxxx

# Password-reset emails (https://resend.com, free tier). Leave empty while testing: the code is printed in the server window.
RESEND_API_KEY=
MAIL_FROM=TT Memory <onboarding@resend.dev>

PORT=8787
# Folder that must survive restarts (a persistent disk/volume in production)
DATA_DIR=./data
# Set to 1 when behind a proxy/load balancer (Render, Railway, Fly) so rate limits see real IPs
TRUST_PROXY=0
# Where Paystack may send users back to after paying (comma separated prefixes)
ALLOWED_CALLBACK_PREFIXES=exp://,ttmemory://

# TESTING ONLY: make a paid period last this many minutes so you can watch the plan expire. Remove for real use.
# PERIOD_MINUTES=3
